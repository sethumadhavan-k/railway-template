{
  "services": [
    {
      "name": "databasus",
      "icon": "https://raw.githubusercontent.com/databasus/databasus/main/assets/logo-square.svg",
      "variables": {
        "DATABASUS_ADMIN_EMAIL": {
          "defaultValue": "",
          "isOptional": false,
          "description": "Admin login email. Created on first boot; sign in with this account."
        },
        "DATABASUS_ADMIN_PASSWORD": {
          "defaultValue": "",
          "isOptional": false,
          "description": "Admin password (min 8 chars). Created on first boot."
        },
        "DATABASUS_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "isOptional": true,
          "description": "Optional. Public base URL used in email links."
        },
        "S3_ENDPOINT": {
          "defaultValue": "${{databasus-backups.ENDPOINT}}",
          "isOptional": true,
          "description": "Railway Bucket S3 endpoint. Paste into Databasus → Storages → S3."
        },
        "S3_BUCKET": {
          "defaultValue": "${{databasus-backups.BUCKET}}",
          "isOptional": true,
          "description": "Railway Bucket name for backup archives."
        },
        "S3_REGION": {
          "defaultValue": "${{databasus-backups.REGION}}",
          "isOptional": true,
          "description": "Railway Bucket region (often auto)."
        },
        "S3_ACCESS_KEY_ID": {
          "defaultValue": "${{databasus-backups.ACCESS_KEY_ID}}",
          "isOptional": true,
          "description": "Railway Bucket access key id."
        },
        "S3_SECRET_ACCESS_KEY": {
          "defaultValue": "${{databasus-backups.SECRET_ACCESS_KEY}}",
          "isOptional": true,
          "description": "Railway Bucket secret access key."
        }
      }
    }
  ]
}
