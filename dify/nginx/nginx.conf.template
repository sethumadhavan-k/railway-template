# Dify nginx gateway adapted for Railway.
# - Listens on $PORT (Railway public HTTP; TLS terminated at the edge)
# - Resolves *.railway.internal via fd12::10
# - Uses variable proxy_pass so backends can start after nginx

events {
  worker_connections 1024;
}

http {
  resolver [fd12::10] ipv6=on valid=10s;
  resolver_timeout 5s;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  server {
    listen ${PORT};
    client_max_body_size 100M;

    set $api_backend "http://${API_HOST}:${API_PORT}";
    set $web_backend "http://${WEB_HOST}:${WEB_PORT}";
    set $socket_io_backend "http://${API_WEBSOCKET_HOST}:${API_WEBSOCKET_PORT}";
    set $plugin_daemon_backend "http://${PLUGIN_DAEMON_HOST}:${PLUGIN_DAEMON_PORT}";

    location = /nginx-health {
      access_log off;
      default_type text/plain;
      return 200 'ok';
    }

    location /console/api {
      proxy_pass $api_backend;
      include /etc/nginx/proxy.conf;
    }

    location /api {
      proxy_pass $api_backend;
      include /etc/nginx/proxy.conf;
    }

    location /socket.io/ {
      proxy_pass $socket_io_backend;
      include /etc/nginx/proxy.conf;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_cache_bypass $http_upgrade;
    }

    location /v1 {
      proxy_pass $api_backend;
      include /etc/nginx/proxy.conf;
    }

    location /openapi {
      proxy_pass $api_backend;
      include /etc/nginx/proxy.conf;
    }

    location /files {
      proxy_pass $api_backend;
      include /etc/nginx/proxy.conf;
    }

    location /explore {
      proxy_pass $web_backend;
      include /etc/nginx/proxy.conf;
    }

    location /e/ {
      proxy_pass $plugin_daemon_backend;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include /etc/nginx/proxy.conf;
    }

    location /mcp {
      proxy_pass $api_backend;
      include /etc/nginx/proxy.conf;
    }

    location /triggers {
      proxy_pass $api_backend;
      include /etc/nginx/proxy.conf;
    }

    location / {
      proxy_pass $web_backend;
      include /etc/nginx/proxy.conf;
    }
  }
}
